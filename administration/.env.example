# Administration Le Ter — copier en .env.local et adapter. Ne jamais commiter de valeur réelle.

# URL du backend Le Ter (appelé UNIQUEMENT par le serveur Next.js, jamais par le navigateur).
# Développement local : http://localhost:3000
ADMIN_API_URL=http://localhost:3000

# Origine publique de l'administration (contrôle CSRF des requêtes de modification).
# Vide : l'origine est déduite de l'en-tête Host de la requête.
# Exemple : https://admin.example.com
ADMIN_PUBLIC_ORIGIN=

# Cookies `Secure` (HTTPS obligatoire). Par défaut : true en production, false sinon.
# ADMIN_COOKIE_SECURE=true
