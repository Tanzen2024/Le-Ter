# Copier ce fichier en .env et adapter les valeurs.
# Ne jamais commiter .env ni de valeurs réelles.

# development | test | production
NODE_ENV=development

PORT=3000

# PostgreSQL : base principale, source de vérité (D-022).
# Laisser vide pour démarrer sans base de données (développement uniquement :
# obligatoire quand NODE_ENV=production).
# PostgreSQL installé sur le poste (port standard 5432) : postgres://<user>:<mot_de_passe>@localhost:5432/le_ter
#   (le rôle et la base doivent exister : CREATE ROLE … LOGIN PASSWORD … ; CREATE DATABASE le_ter OWNER …)
# Docker local (docker-compose.yml, port 5433) : postgres://le_ter:le_ter@localhost:5433/le_ter
# Schéma : npm run db:migrate
DATABASE_URL=

# Redis : temps réel, coordination, cache court terme. Jamais source de vérité (D-024).
# Laisser vide : diffusion des événements limitée à une seule instance.
# Exemple local : redis://localhost:6379
REDIS_URL=

# Authentification (D-029). Aucun secret par défaut : sans JWT_SECRET, les routes
# /api/auth répondent 503 ; en production, son absence empêche le démarrage.
# 32 caractères minimum, aléatoires. Générer par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Durée d'un access token JWT (format 15m, 12h, 30d…). Défaut : 15m.
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# Durée d'un refresh token, renouvelée à chaque rotation. Défaut : 30d.
REFRESH_TOKEN_EXPIRES_IN=30d

# Paiements CinetPay — NOUVELLE API v1 (D-050, docs/payments.md). Achats seulement.
# Laisser CINETPAY_API_KEY et CINETPAY_API_PASSWORD vides : aucun fournisseur, achats refusés
# proprement. Valeurs réelles UNIQUEMENT dans backend/.env (jamais commité).
# Clé sandbox : sk_test_…  ·  clé production : sk_live_…
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Facultatif : déduit du préfixe de la clé (sandbox https://api.cinetpay.net,
# production https://api.cinetpay.co).
CINETPAY_BASE_URL=
# URL PUBLIQUES de ce backend, joignables par CinetPay (120 caractères max, HTTPS en production).
# JAMAIS une adresse LAN (10.x, 192.168.x), localhost ni Tailscale (100.64-127.x) : CinetPay ne
# les joint pas (notifications perdues ; refus de démarrer en production, avertissement sinon).
# Exemple fictif : https://api.example.com/api/payments/cinetpay/notify
CINETPAY_NOTIFY_URL=
# Exemple fictif : https://api.example.com/api/payments/cinetpay/return
CINETPAY_RETURN_URL=
# Retour dans l'application après la page de paiement. Défaut : leter://payment/return
CINETPAY_APP_RETURN_URL=
# Délai maximal d'un appel à CinetPay, en millisecondes (1000 à 60000). Défaut : 15000.
CINETPAY_TIMEOUT_MS=15000
# Intervalle de la réconciliation automatique des paiements en attente, en millisecondes
# (5000 à 3600000). Défaut : 30000. Elle relit le statut chez CinetPay sans notification ni
# application ouverte, et crédite une seule fois (même règlement que la notification).
CINETPAY_RECONCILE_INTERVAL_MS=
# Paiement DIRECT, sans redirection (D-083, docs/payments.md) : opérateurs séparés par des
# virgules. VIDE par défaut = désactivé (page CinetPay seulement). N'activer qu'après
# confirmation par CinetPay que le mode direct est ouvert sur le compte marchand. Seul MTN_CM
# est accepté : OM_CM exige un code OTP saisi par le payeur, dont la collecte n'est pas
# autorisée (refusé au démarrage). Le numéro utilisé est le numéro d'inscription (+237).
CINETPAY_DIRECT_PAY_METHODS=
# Opérateurs PRÉSÉLECTIONNÉS sur la page CinetPay hébergée (D-087) : MTN_CM, OM_CM. VIDE par
# défaut = page générique (toutes les méthodes activées sur le compte). N'ajouter un opérateur
# qu'après confirmation par CinetPay que la présélection est acceptée pour le compte. Aucun OTP
# n'est en jeu (le payeur saisit tout sur la page CinetPay).
CINETPAY_PAGE_PRESELECT_METHODS=
# Retraits Mobile Money par l'API de TRANSFERT CinetPay v1 (D-075, docs/withdrawals.md).
# `false` par défaut : nouvelles demandes refusées (503), rien n'est débité, AUCUN transfert
# envoyé. La relecture des retraits déjà ouverts continue (réconciliation, notifications) dès
# que CINETPAY_API_KEY est configuré (D-076). N'activer qu'une fois le transfert activé ET
# approvisionné sur le compte marchand CinetPay.
CINETPAY_TRANSFERS_ENABLED=false
# Requis si activé. URL PUBLIQUE de ce backend (120 caractères max, HTTPS en production).
# Exemple fictif : https://api.example.com/api/withdrawals/cinetpay/notify
CINETPAY_TRANSFER_NOTIFY_URL=
# Envois au plus par retrait (1 à 3). Défaut 1 : AUCUN renvoi automatique après une réponse
# ambiguë suivie d'un « introuvable ». Ne relever qu'après confirmation en sandbox du
# comportement de CinetPay (NOT_FOUND fiable, référence réutilisée refusée : TRANSACTION_EXIST).
CINETPAY_TRANSFER_MAX_SUBMISSIONS=1
# Production seulement (clé sk_live_, D-077) : `true` atteste que les prérequis sont validés
# (transfert activé et approvisionné chez CinetPay, notification HTTPS publique testée,
# parcours validé en sandbox). Sans elle, une clé live laisse les retraits indisponibles.
# Ignorée avec une clé sk_test_ (mode test). Une clé sk_test_ en NODE_ENV=production est refusée.
CINETPAY_TRANSFERS_LIVE_CONFIRMED=false

# Retraits des revenus de la PLATEFORME vers MTN Mobile Money (D-078, docs/platform-payouts.md).
# Désactivé par défaut. Même à true, l'exécution exige aussi des transferts CinetPay disponibles
# (D-077) et l'URL ci-dessous. Ne pas activer sans la procédure d'activation validée.
PLATFORM_PAYOUTS_ENABLED=false
# URL PUBLIQUE de POST /api/platform-payouts/cinetpay/notify (120 caractères max), requise si
# activé. Exemple fictif : https://api.example.com/api/platform-payouts/cinetpay/notify
PLATFORM_PAYOUT_NOTIFY_URL=
# Barème CONTRACTUEL des frais de transfert CinetPay (points de base, part fixe en FCFA).
# Vides : frais inconnus, aucun retrait de la plateforme ne peut être créé (rien n'est inventé).
PLATFORM_PAYOUT_FEE_BPS=
PLATFORM_PAYOUT_FEE_FIXED=

# Proxys de confiance (Express `trust proxy`, D-061). VIDE par défaut : l'adresse du client
# est celle de la connexion TCP et `X-Forwarded-For` est ignoré (il est falsifiable).
# À renseigner UNIQUEMENT quand l'infrastructure réelle est connue : nombre de sauts (1 à 10),
# loopback / linklocal / uniquelocal, ou adresses / CIDR séparés par des virgules.
# `true` est refusé. Exemple : TRUST_PROXY=loopback
TRUST_PROXY=

# Assistant automatisé des réclamations (D-114, docs/complaints.md). VIDE ou `none` par défaut :
# AUCUN modèle — les réclamations restent entièrement utilisables (dépôt, suivi, réponses du
# support) et l'assistant répond en mode dégradé (vérifications serveur, réponses fixes).
# `ollama` : modèle open-weight exécuté sur NOS machines (aucune API externe payante).
AI_PROVIDER=
# Adresse INTERNE d'Ollama, jamais exposée à l'application mobile ni journalisée. Sans
# identifiant dans l'URL. Backend sur l'hôte : http://127.0.0.1:11434 ; backend dans le même
# réseau Docker que le service `ollama` de docker-compose.yml : http://ollama:11434
OLLAMA_BASE_URL=
# Modèle (doit avoir été téléchargé : `ollama pull <modèle>`). Défaut : qwen2.5:1.5b
# (≈ 1 Go en Q4, CPU seul, 8 Go de RAM). Serveur ≥ 16 Go de RAM : qwen2.5:3b.
OLLAMA_MODEL=qwen2.5:1.5b
# Maintien du modèle en mémoire entre deux appels (ex. 10m, 0 pour libérer aussitôt).
OLLAMA_KEEP_ALIVE=10m
# Délai maximal d'un appel au modèle (2000 à 180000 ms). Défaut : 60000. Au-delà : mode dégradé.
AI_TIMEOUT_MS=60000
# Fenêtre de contexte (1024 à 32768 jetons). Défaut : 4096 (mémoire bornée).
AI_CONTEXT_TOKENS=4096
# Longueur maximale d'une réponse générée (64 à 2048 jetons). Défaut : 350.
AI_MAX_OUTPUT_TOKENS=350
# Appels simultanés au modèle (1 sur CPU) et appels en attente au-delà desquels on répond
# « occupé » (mode dégradé) plutôt que d'empiler. Défauts : 1 et 4.
AI_MAX_CONCURRENCY=1
AI_MAX_QUEUE=4
# Messages envoyés à l'assistant par joueur et par heure (défaut 20 ; rafale bornée à 6/min).
AI_PLAYER_MESSAGES_PER_HOUR=20
# Messages du joueur par conversation ; au-delà, plus d'appel au modèle (défaut 15).
AI_MAX_TURNS_PER_CONVERSATION=15
