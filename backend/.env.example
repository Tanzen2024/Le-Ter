# Copier ce fichier en .env et adapter les valeurs.
# Ne jamais commiter .env ni de valeurs réelles.

# development | test | production
NODE_ENV=development

PORT=3000

# PostgreSQL : base principale, source de vérité (D-022).
# Laisser vide pour démarrer sans base de données (développement uniquement :
# obligatoire quand NODE_ENV=production).
# Docker local (docker-compose.yml, port 5433) : postgres://le_ter:le_ter@localhost:5433/le_ter
# Schéma : npm run db:migrate
DATABASE_URL=

# Redis : temps réel, coordination, cache court terme. Jamais source de vérité (D-024).
# Laisser vide : diffusion des événements limitée à une seule instance.
# Exemple local : redis://localhost:6379
REDIS_URL=

# Authentification (D-029). Aucun secret par défaut : sans JWT_SECRET, les routes
# /api/auth répondent 503 ; en production, son absence empêche le démarrage.
# 32 caractères minimum, aléatoires. Générer par exemple avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# Durée d'un access token JWT (format 15m, 12h, 30d…). Défaut : 15m.
JWT_ACCESS_TOKEN_EXPIRES_IN=15m
# Durée d'un refresh token, renouvelée à chaque rotation. Défaut : 30d.
REFRESH_TOKEN_EXPIRES_IN=30d

# Paiements CinetPay — NOUVELLE API v1 (D-050, docs/payments.md). Achats seulement.
# Laisser CINETPAY_API_KEY et CINETPAY_API_PASSWORD vides : aucun fournisseur, achats refusés
# proprement. Valeurs réelles UNIQUEMENT dans backend/.env (jamais commité).
# Clé sandbox : sk_test_…  ·  clé production : sk_live_…
CINETPAY_API_KEY=
CINETPAY_API_PASSWORD=
# Facultatif : déduit du préfixe de la clé (sandbox https://api.cinetpay.net,
# production https://api.cinetpay.co).
CINETPAY_BASE_URL=
# URL PUBLIQUES de ce backend, joignables par CinetPay (120 caractères max, HTTPS en production).
# Exemple fictif : https://api.example.com/api/payments/cinetpay/notify
CINETPAY_NOTIFY_URL=
# Exemple fictif : https://api.example.com/api/payments/cinetpay/return
CINETPAY_RETURN_URL=
# Retour dans l'application après la page de paiement. Défaut : leter://payment/return
CINETPAY_APP_RETURN_URL=
# Délai maximal d'un appel à CinetPay, en millisecondes (1000 à 60000). Défaut : 15000.
CINETPAY_TIMEOUT_MS=15000

# Proxys de confiance (Express `trust proxy`, D-061). VIDE par défaut : l'adresse du client
# est celle de la connexion TCP et `X-Forwarded-For` est ignoré (il est falsifiable).
# À renseigner UNIQUEMENT quand l'infrastructure réelle est connue : nombre de sauts (1 à 10),
# loopback / linklocal / uniquelocal, ou adresses / CIDR séparés par des virgules.
# `true` est refusé. Exemple : TRUST_PROXY=loopback
TRUST_PROXY=
