{
  "name": "le-ter-backend",
  "version": "1.0.0",
  "private": true,
  "main": "dist/server.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "dev:tunnel": "tsx src/cli/dev-tunnel.ts",
    "test:accounts": "tsx src/cli/test-accounts.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "db:migrate": "tsx src/database/migrate.ts",
    "db:migrate:prod": "node dist/database/migrate.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --experimental-vm-modules --no-warnings=ExperimentalWarning node_modules/jest/bin/jest.js",
    "game:finish": "tsx src/cli/finish-game.ts",
    "game:finish:prod": "node dist/cli/finish-game.js",
    "payments:diagnose": "tsx src/cli/payments-diagnose.ts",
    "payments:diagnose:prod": "node dist/cli/payments-diagnose.js",
    "withdrawals:check-operators": "tsx src/cli/withdrawals-check-operators.ts",
    "withdrawals:check-operators:prod": "node dist/cli/withdrawals-check-operators.js",
    "user:role": "tsx src/cli/set-user-role.ts",
    "user:role:prod": "node dist/cli/set-user-role.js",
    "tournament:create": "tsx src/cli/tournament-create.ts",
    "tournament:create:prod": "node dist/cli/tournament-create.js"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3",
    "libphonenumber-js": "^1.13.15",
    "pg": "^8.23.1",
    "redis": "^6.3.0",
    "ws": "^8.22.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/ws": "^8.18.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "jest": "^30.5.2",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.1"
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/tests"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "maxWorkers": "50%",
    "workerIdleMemoryLimit": "1GB"
  }
}
