{
  "name": "le-ter-frontend",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo-google-fonts/cinzel": "^0.4.2",
    "@expo-google-fonts/rajdhani": "^0.4.1",
    "@tanstack/react-query": "^5.104.1",
    "expo": "~57.0.27",
    "expo-asset": "~57.0.19",
    "expo-audio": "~57.0.5",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.3",
    "expo-font": "~57.0.4",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.20",
    "expo-router": "~57.0.25",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-web-browser": "~57.0.3",
    "libphonenumber-js": "^1.13.15",
    "lucide-react-native": "^1.54.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-svg": "15.15.4",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "~19.2.2",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "~29.7.0",
    "jest-expo": "~57.0.5",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "start:tailscale": "node scripts/start-tailscale.mjs",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "jest"
  },
  "private": true,
  "jest": {
    "preset": "jest-expo",
    "testMatch": [
      "<rootDir>/src/**/*.test.ts?(x)"
    ],
    "setupFiles": [
      "<rootDir>/src/test/jest-setup.ts"
    ],
    "testTimeout": 30000,
    "moduleNameMapper": {
      "^lucide-react-native$": "<rootDir>/node_modules/lucide-react-native/dist/cjs/lucide-react-native.js"
    }
  }
