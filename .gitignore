# Le Ter — .gitignore racine (frontend/ + backend/ + docs/)
# docs/ est la source de vérité : il DOIT rester suivi par Git.

# ---------------------------------------------------------------
# Dépendances (chaque application a son propre node_modules)
# ---------------------------------------------------------------
node_modules/
frontend/node_modules/
backend/node_modules/

# ---------------------------------------------------------------
# Secrets et environnement
# ---------------------------------------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.keystore
*.mobileprovision
google-services.json
GoogleService-Info.plist
serviceAccount*.json
*-service-account*.json

# ---------------------------------------------------------------
# Frontend (Expo)
# ---------------------------------------------------------------
frontend/.expo/
frontend/dist/
frontend/web-build/
frontend/expo-env.d.ts
# Sources WAV de travail de la musique, régénérées par scripts/generate-music.mjs
frontend/audio-src/
# Dossiers natifs générés (Continuous Native Generation)
frontend/ios/
frontend/android/
.kotlin/
*.orig.*
.metro-health-check*

# ---------------------------------------------------------------
# Backend (Node.js / TypeScript)
# ---------------------------------------------------------------
backend/dist/
backend/coverage/

# ---------------------------------------------------------------
# Outils, logs, fichiers temporaires
# ---------------------------------------------------------------
coverage/
*.tsbuildinfo
*.log
npm-debug.*
yarn-debug.*
yarn-error.*
*.tmp
*.swp

# Fichiers de verrou Office (ouverture d'un .docx dans docs/)
~$*

# Systèmes d'exploitation
.DS_Store
Thumbs.db
desktop.ini
